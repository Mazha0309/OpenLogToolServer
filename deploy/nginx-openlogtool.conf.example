server {
    listen 443 ssl;
    server_name openlogtool.example.com;

    # Configure ssl_certificate / ssl_certificate_key for your environment.

    location /ws/ {
        # This dedicated block is for LiveShare and collaboration WebSockets.
        # Keep HTTP/1.1 Upgrade forwarding here; archive pages do not need it.
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        # $http_host preserves a non-default external port when one is used.
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
    }

    location / {
        # Forward the generic root unchanged to Express. The application serves
        # published archive aliases, so do not rewrite or reject /BR5AI or the
        # nested public path /BR5AI/session/<id>. These are public alias routes,
        # not WebSocket requests and need no Upgrade headers.
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
